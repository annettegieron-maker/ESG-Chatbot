\f0\fs24 \cf0 import streamlit as st\
import requests\
import json\
import pandas as pd\
from datetime import datetime\
import re\
\
st.set_page_config(page_title="Datensammlung Chatbot", layout="wide")\
\
st.title("\uc0\u55358 \u56598  Datensammlungs-Chatbot")\
st.info("\uc0\u55357 \u56481  Bot fragt Schritt f\'fcr Schritt nach Name, E-Mail, Telefon, Anliegen")\
\
# ===== IHRE AZURE OPENAI WERTE HIER EINF\'dcGEN =====\
API_BASE = "https://IHR-ACCOUNT.openai.azure.com/"  # Aus Playground Zeile 9\
API_KEY = "AIzaSyDxxxxxxxxxxxxxxxxxxxxxx"           # Aus Playground Zeile 10\
MODEL_NAME = "chatbot-model"                        # Aus Playground Zeile 11\
\
if "messages" not in st.session_state:\
    st.session_state.messages = []\
\
# Sidebar Excel-Status\
with st.sidebar:\
    st.header("\uc0\u55357 \u56522  Excel-Status")\
    try:\
        df = pd.read_excel('daten.xlsx')\
        st.success(f"\uc0\u9989  \{len(df)\} Eintr\'e4ge")\
        st.dataframe(df.tail(3))\
    except:\
        st.info("\uc0\u55357 \u56541  Erste Daten...")\
\
# Chat-Historie\
for msg in st.session_state.messages:\
    with st.chat_message(msg["role"]):\
        st.markdown(msg["content"])\
\
# Neue Nachricht\
if prompt := st.chat_input("Ihre Antwort..."):\
    st.session_state.messages.append(\{"role": "user", "content": prompt\})\
    with st.chat_message("user"):\
        st.markdown(prompt)\
\
    with st.chat_message("assistant"):\
        # API-Aufruf\
        url = f"\{API_BASE\}openai/deployments/\{MODEL_NAME\}/chat/completions?api-version=2024-02-15-preview"\
        headers = \{"api-key": API_KEY, "Content-Type": "application/json"\}\
        data = \{\
            "messages": [\
                \{"role": "system", "content": "Frage EXAKT: 1\uc0\u65039 \u8419  Name 2\u65039 \u8419  E-Mail 3\u65039 \u8419  Telefon 4\u65039 \u8419  Anliegen. Ende: JSON \{\\"name\\":\\"...\\",\\"email\\":\\"...\\",\\"phone\\":\\"...\\",\\"anliegen\\":\\"...\\"\}"\},\
                *[\{"role": m["role"], "content": m["content"]\} for m in st.session_state.messages]\
            ],\
            "max_tokens": 400\
        \}\
        \
        response = requests.post(url, headers=headers, json=data)\
        reply = response.json()["choices"][0]["message"]["content"]\
        \
        st.markdown(reply)\
        st.session_state.messages.append(\{"role": "assistant", "content": reply\})\
\
        # JSON \uc0\u8594  Excel\
        json_match = re.search(r'\\\{.*\\\}', reply, re.DOTALL)\
        if json_match:\
            try:\
                data_dict = json.loads(json_match.group())\
                df_new = pd.DataFrame([\{\
                    'Datum': [datetime.now()],\
                    'Name': [data_dict.get('name', '')],\
                    'E-Mail': [data_dict.get('email', '')],\
                    'Telefon': [data_dict.get('phone', '')],\
                    'Anliegen': [data_dict.get('anliegen', '')]\
                \}])\
                \
                try:\
                    df = pd.read_excel('daten.xlsx')\
                    df = pd.concat([df, df_new], ignore_index=True)\
                except:\
                    df = df_new\
                \
                df.to_excel('daten.xlsx', index=False)\
                st.balloons()\
                st.sidebar.success("\uc0\u55357 \u56510  Excel aktualisiert!")\
            except Exception as e:\
                st.error(f"JSON-Fehler: \{e\}")\
}